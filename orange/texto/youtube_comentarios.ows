<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="YouTube - Analisis de texto de comentarios (Etapa 6)" description="Corpus de 703 comentarios de 8 videos de YouTube sobre incendios forestales en Colombia (data/etapa6/youtube/comentarios_limpios.csv). Preprocesamiento en espanol, bolsa de palabras TF-IDF, temas (LDA), clustering jerarquico (Ward), enriquecimiento de palabras, sentimiento (Multilingual) y comparacion por video. Ver docs/etapa6/informe_youtube.md seccion 3 para los parametros exactos de cada widget.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="" version="" title="File (comentarios_limpios.csv)" position="(50, 50)" />
