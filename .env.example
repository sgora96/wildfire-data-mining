# Copia este archivo como `.env` y ajusta los valores.
# `.env` esta ignorado por git y no debe subirse al repositorio.

# Perfil de configuracion: development | production | testing | freeze
FLASK_CONFIG=development

# Servidor de desarrollo
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Clave de sesion (genera una propia en produccion)
SECRET_KEY=cambia-esta-clave-en-produccion

# Opcional: fuerza URLs absolutas al congelar el sitio estatico.
# Dejalo vacio para usar URLs relativas (recomendado en GitHub Pages).
# FREEZER_BASE_URL=https://sgora96.github.io/wildfire-data-mining/
