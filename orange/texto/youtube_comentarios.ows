		<node id="5" name="Distances" qualified_name="Orange.widgets.unsupervised.owdistances.OWDistances" project_name="" version="" title="Distances (Euclidea)" position="(890, 140)" />
		<node id="6" name="Hierarchical Clustering" qualified_name="Orange.widgets.unsupervised.owhierarchicalclustering.OWHierarchicalClustering" project_name="" version="" title="Hierarchical Clustering (Ward)" position="(1100, 140)" />
		<node id="7" name="Word Enrichment" qualified_name="orangecontrib.text.widgets.owwordenrichment.OWWordEnrichment" project_name="" version="" title="Word Enrichment" position="(1310, 140)" />
